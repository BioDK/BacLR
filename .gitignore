# --- Raw and large data files (never commit) ---
data/raw/
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.pod5
*.fast5
*.bam
*.bam.bai

# --- Download logs (curl/wget progress output, not project history) ---
data/logs/
*.curl.log
data/*_ena_files.tsv

# --- Pipeline outputs (regenerated by the workflow) ---
# We keep the results/ folder structure and the mock methylation example,
# but ignore actual generated result files.
results/filtered_reads/*
results/assembly/*
results/qc/*
results/taxonomy/*
results/annotation/*
results/methylation/*
results/summary/*
!results/**/.gitkeep
!results/methylation/example_output/
!results/methylation/example_output/**

# --- Reference databases (multi-GB, download locally) ---
db/
*.dmnd
checkm2_db/
bakta_db/
gtdbtk_db/

# --- Snakemake internals ---
.snakemake/
*.snakemake.log

# --- Local-only notes (kept on disk, not published) ---
docs/application_notes.md

# --- Conda / environments ---
.conda/
envs/*.lock

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# --- OS / editor cruft ---
.DS_Store
*.swp
.vscode/
.idea/
